{
    // Use IntelliSense to learn about possible attributes.
    // Hover to view descriptions of existing attributes.
    // For more information, visit: https://go.microsoft.com/fwlink/?linkid=830387
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Python Debugger: Current File",
            "type": "debugpy",
            "request": "launch",
            "program": "${file}",
            "console": "integratedTerminal"
        },
        {
            "name": "shadow_hand",
            "type": "debugpy",
            "request": "launch",
            "program": "${workspaceFolder}/eureka/eureka.py",
            "console": "integratedTerminal",
            "args": ["env=shadow_hand", "sample=4", "iteration=2", "max_iterations=3000", "model=gpt-4o"],
            "cwd": "${workspaceFolder}/eureka"
        },
        {
            "name": "allegro_hand",
            "type": "debugpy",
            "request": "launch",
            "program": "${workspaceFolder}/eureka/eureka.py",
            "console": "integratedTerminal",
            "args": ["env=allegro_hand", "sample=4", "iteration=2", "max_iterations=3000", "model=gpt-4o"],
            "cwd": "${workspaceFolder}/eureka"
        },
        {
            "name": "demo_shadow_hand",
            "type": "debugpy",
            "request": "launch",
            "program": "${workspaceFolder}/isaacgymenvs/isaacgymenvs/train.py",
            "console": "integratedTerminal",
            "args": ["test=True", "headless=False", "force_render=True", "task=ShadowHandSpin", "checkpoint=checkpoints/EurekaPenSpinning.pth"],
            "cwd": "${workspaceFolder}"
        },
        {
            "name": "display_shadow_hand",
            "type": "debugpy",
            "request": "launch",
            "program": "${workspaceFolder}/isaacgymenvs/isaacgymenvs/test.py",
            "console": "integratedTerminal",
            "args": ["test=True", "headless=False", "force_render=True", "task=ShadowHandSpin", "checkpoint=checkpoints/EurekaPenSpinning.pth"],
            "cwd": "${workspaceFolder}"
        },
    ]
}